SPRING_PROFILES_ACTIVE=dev

# Application Configuration
APP_NAME=template

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=template
DB_USER=admin
DB_PASSWORD=admin

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# Feign
FEIGN_CONNECT_TIMEOUT=5000
FEIGN_READ_TIMEOUT=5000

# External services
RANDOMUSER_SERVICE_URL=https://randomuser.me

# Kafka
KAFKA_HOST=kafka
KAFKA_PORT=9092